# Binance credentials — public-safe template.
# Copy this file to `.env` and fill in your real keys (local only):
#   cp .env.example .env
# Keep real values only in local `.env` or GitHub Actions Secrets; never commit them.
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_api_secret_here

# Optional: expected Binance UID used only for validation in the daily report.
BINANCE_UID=

# Optional: signed-request receive window in milliseconds (safe default: 5000).
BINANCE_RECV_WINDOW=5000

# Optional: override the REST base URL (e.g. a mirror domain).
BINANCE_BASE_URL=https://api.binance.com
